# MoveScout environment template
#
# Copy this file to `.env.local` (preferred for dev) or `.env` (kept out of git by default) and fill in values.
# For Plesk: you can also set these under Node.js → "Benutzerdefinierte Umgebungsvariablen".

# Required: Postgres connection string
# Example (hosted Postgres usually needs SSL): postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
DATABASE_URL=

# Crypto / Auth (required in production)
MOVESCOUT_DATA_ENCRYPTION_KEY=
MOVESCOUT_AUTH_TOKEN_SECRET=

# Optional org defaults
MOVESCOUT_DEFAULT_ORG_KEY=org_default

# Optional local documents backend (used in dev when SFTP integration is not configured)
# Default: ./data/documents
MOVESCOUT_DOCUMENTS_ROOT=

# Bootstrap admin (created on first run if no users exist)
MOVESCOUT_BOOTSTRAP_ADMIN_USERNAME=Admin
MOVESCOUT_BOOTSTRAP_ADMIN_PASSWORD=

# Optional mail fallback (used if integration settings are not set in DB)
MOVESCOUT_SMTP_HOST=
MOVESCOUT_SMTP_PORT=
MOVESCOUT_SMTP_USER=
MOVESCOUT_SMTP_PASS=
MOVESCOUT_MAIL_FROM=

# Optional routing/geocoding overrides
MOVESCOUT_GEOCODING_URL=
MOVESCOUT_ROUTING_URL=
MOVESCOUT_GEOCODING_USER_AGENT=

# Optional: SFTP sync helper (used by `npm run sftp:sync`, not by the app runtime)
MOVESCOUT_SFTP_HOST=
MOVESCOUT_SFTP_PORT=22
MOVESCOUT_SFTP_USER=
MOVESCOUT_SFTP_PASS=
MOVESCOUT_SFTP_PRIVATE_KEY_PATH=
MOVESCOUT_SFTP_REMOTE_ROOT=/movescout/documents
